{
  "name": "bhe-teacher-grants",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vinext build",
    "cf-typegen": "wrangler types",
    "dev": "vinext dev",
    "dev:migrate": "wrangler d1 migrations apply bhe-teacher-grants-db --local",
    "dev:migrations:list": "wrangler d1 migrations list bhe-teacher-grants-db --local",
    "postinstall": "pnpm run cf-typegen",
    "preview": "pnpm run build && vinext start",
    "prod:deploy": "pnpm run build && wrangler deploy",
    "prod:migrate": "wrangler d1 migrations apply bhe-teacher-grants-db --remote",
    "stage:deploy": "pnpm run build && wrangler deploy --env stage",
    "stage:migrate": "wrangler d1 migrations apply DB --remote --env stage",
    "stage:tail": "wrangler tail --env stage",
    "stage:secret": "wrangler secret put --env stage",
    "stage:secret:bulk": "wrangler secret bulk --env stage",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm run cf-typegen && vinext typegen && tsc -b"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@sentry/cloudflare": "^10.78.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "driver.js": "^1.14.0",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "1.4.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plus": "^1.7.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
